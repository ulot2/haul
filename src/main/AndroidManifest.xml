<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 14+: downloads run as a user-initiated data transfer job (HaulJob), which waits for a connection. -->
    <uses-permission android:name="android.permission.RUN_USER_INITIATED_JOBS" />
    <!-- To say "waiting for a connection" in the hold. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".App"
        android:label="Haul"
        android:icon="@drawable/ic_launcher"
        android:theme="@style/Theme.Haul"
        android:extractNativeLibs="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Haul.Launch"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Haul's own player. Keeps playing through a turn of the phone. -->
        <activity
            android:name=".PlayerActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="false"
            android:theme="@style/Theme.Haul.Player" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!-- Over the app a link came from: takes the link from the share sheet (TikTok, Instagram, X...), starts the
             download (after a quick quality choice, if that setting is on), and closes. -->
        <activity
            android:name=".ShareActivity"
            android:exported="true"
            android:label="Haul"
            android:theme="@style/Theme.Haul.Over"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- "Haul audio" in the share sheet: the same screen, saving just the sound. Settings can hide it. -->
        <activity-alias
            android:name=".ShareAudio"
            android:enabled="true"
            android:exported="true"
            android:icon="@drawable/ic_launcher_audio"
            android:label="Haul audio"
            android:targetActivity=".ShareActivity">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias>

        <!-- Opened by the Quick Settings tile: reads the copied link (only an app on screen may), starts it, closes. -->
        <activity
            android:name=".ClipActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Haul.Over" />

        <!-- The Quick Settings tile, "Download copied link". -->
        <service
            android:name=".HaulTile"
            android:exported="true"
            android:icon="@drawable/ic_notify"
            android:label="Haul"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Android 10-13, or when Android refuses the job: the queue runs in a foreground service. -->
        <service
            android:name=".HaulService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Android 14+: the queue runs as a user-initiated job. Only the system can bind it (BIND_JOB_SERVICE). -->
        <service
            android:name=".HaulJob"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- The Cancel button on the download notification, and Delete on a "Saved" one. -->
        <receiver
            android:name=".CancelReceiver"
            android:exported="false" />
        <receiver
            android:name=".DeleteReceiver"
            android:exported="false" />
    </application>
</manifest>
