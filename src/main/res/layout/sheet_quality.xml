<?xml version="1.0" encoding="utf-8"?>
<!-- HAUL THIS AS: shown over TikTok (or any app) after Share > Haul, when "Ask quality when sharing" is on.
     The scrim is Haul's own, since this screen is see-through; tapping it cancels. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/qScrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#99000000"
    android:clickable="true"
    android:contentDescription="Cancel"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/qSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_sheet"
        android:clickable="true"
        android:focusable="false"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <View style="@style/Haul.Handle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                style="@style/Haul.Heading"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="HAUL THIS AS" />

            <TextView
                android:id="@+id/qSite"
                style="@style/Haul.Label" />
        </LinearLayout>

        <TextView
            android:id="@+id/qLink"
            style="@style/Haul.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="middle"
            android:singleLine="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button android:id="@+id/qBest" style="@style/Haul.Segment" android:layout_height="56dp" android:text="Best" />
            <Button android:id="@+id/qSmall" style="@style/Haul.Segment" android:layout_height="56dp" android:text="720p" />
            <Button android:id="@+id/qAudio" style="@style/Haul.Segment" android:layout_height="56dp" android:text="Audio" />
            <Button android:id="@+id/qGif" style="@style/Haul.Segment" android:layout_height="56dp" android:layout_marginEnd="0dp" android:text="GIF" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
