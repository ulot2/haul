<?xml version="1.0" encoding="utf-8"?>
<!-- WELCOME: the first time Haul opens, three steps on how to use it, each with a small picture of that part of Haul.
     Settings › About opens it again. The pictures are drawings, not buttons. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/welcomeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ground"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="18dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_mark" />

        <TextView
            style="@style/Haul.Wordmark"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="HAUL"
            android:textSize="30sp" />

        <Button
            android:id="@+id/welcomeSkip"
            style="@style/Haul.Button"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:text="Skip"
            android:textColor="@color/ink_muted"
            android:textSize="15sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <FrameLayout
            android:id="@+id/welcomePages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="28dp"
            android:paddingBottom="12dp">

            <!-- 1: the share sheet -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView style="@style/Haul.Label" android:text="Step 1 of 3" />

                <TextView
                    style="@style/Haul.Heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="SHARE IT\nTO HAUL"
                    android:textSize="44sp" />

                <TextView
                    style="@style/Haul.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="In TikTok, Instagram, X, YouTube or any app, tap Share, then Haul. It downloads in the background and lands in your Gallery, in the Haul album. Haul audio saves just the sound."
                    android:textSize="16sp" />

                <LinearLayout
                    style="@style/Haul.Card"
                    android:layout_marginTop="26dp"
                    android:contentDescription="The share sheet, with Haul and Haul audio next to Copy link"
                    android:importantForAccessibility="noHideDescendants"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp">

                    <TextView style="@style/Haul.Label" android:text="Share to" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
                            <FrameLayout android:layout_width="66dp" android:layout_height="66dp">
                                <ImageView
                                    android:layout_width="56dp"
                                    android:layout_height="56dp"
                                    android:layout_gravity="center"
                                    android:background="@drawable/bg_circle"
                                    android:padding="16dp"
                                    android:src="@drawable/ic_link"
                                    android:tint="@color/ink" />
                            </FrameLayout>
                            <TextView style="@style/Haul.Meta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Copy link" />
                        </LinearLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
                            <FrameLayout android:layout_width="66dp" android:layout_height="66dp" android:background="@drawable/bg_circle_pick">
                                <ImageView
                                    android:layout_width="56dp"
                                    android:layout_height="56dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_launcher" />
                            </FrameLayout>
                            <TextView style="@style/Haul.Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Haul" android:textSize="13sp" />
                        </LinearLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
                            <FrameLayout android:layout_width="66dp" android:layout_height="66dp">
                                <ImageView
                                    android:layout_width="56dp"
                                    android:layout_height="56dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_launcher_audio" />
                            </FrameLayout>
                            <TextView style="@style/Haul.Meta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Haul audio" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- 2: the copied link in the dock -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView style="@style/Haul.Label" android:text="Step 2 of 3" />

                <TextView
                    style="@style/Haul.Heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="OR COPY\nTHE LINK"
                    android:textSize="44sp" />

                <TextView
                    style="@style/Haul.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Copy a link anywhere, then open Haul: it waits at the bottom, one tap from downloading. Options picks the quality, or clips a section of a long video."
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:background="@drawable/bg_dock"
                    android:contentDescription="The copied link at the bottom of Haul, with Options and Download"
                    android:importantForAccessibility="noHideDescendants"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView style="@style/Haul.Label" android:text="Copied link · TikTok" />

                    <TextView
                        style="@style/Haul.Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="tiktok.com/@someone/video/7301…"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <Button
                            style="@style/Haul.Button.Outline"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:clickable="false"
                            android:focusable="false"
                            android:text="Options" />

                        <Button
                            style="@style/Haul.Button.Primary"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="10dp"
                            android:layout_weight="2"
                            android:clickable="false"
                            android:drawableStart="@drawable/ic_download"
                            android:focusable="false"
                            android:text="Download · Best"
                            android:textSize="16sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    style="@style/Haul.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Quicker still: add the Haul tile to Quick Settings (Settings › Shortcuts). Copy a link, pull down, tap Haul."
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 3: picking from a post -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView style="@style/Haul.Label" android:text="Step 3 of 3" />

                <TextView
                    style="@style/Haul.Heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="PICK WHAT\nYOU KEEP"
                    android:textSize="44sp" />

                <TextView
                    style="@style/Haul.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="A post with several photos or videos shows them all: tap the ones to leave out. A TikTok photo post saves as videos with its sound, as photos, or just the sound."
                    android:textSize="16sp" />

                <LinearLayout
                    style="@style/Haul.Card"
                    android:layout_marginTop="26dp"
                    android:contentDescription="The picker: three pictures, two chosen and one left out, and Video, Photos or Sound"
                    android:importantForAccessibility="noHideDescendants">

                    <TextView style="@style/Haul.Label" android:text="Pick from the post" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="104dp"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_thumb" android:backgroundTint="@color/tone0">
                            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="top|end" android:layout_margin="6dp" android:background="@drawable/bg_check_on" android:padding="3dp" android:src="@drawable/ic_check" android:tint="@color/on_clay" />
                        </FrameLayout>

                        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/bg_thumb" android:backgroundTint="@color/tone1">
                            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="top|end" android:layout_margin="6dp" android:background="@drawable/bg_check_on" android:padding="3dp" android:src="@drawable/ic_check" android:tint="@color/on_clay" />
                        </FrameLayout>

                        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="6dp" android:layout_weight="1" android:alpha="0.45" android:background="@drawable/bg_thumb" android:backgroundTint="@color/tone2">
                            <View android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="top|end" android:layout_margin="6dp" android:background="@drawable/bg_check_off" />
                        </FrameLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <Button android:id="@+id/welcomeVideo" style="@style/Haul.Segment" android:layout_height="38dp" android:clickable="false" android:focusable="false" android:text="Video" android:textSize="13sp" />
                        <Button style="@style/Haul.Segment" android:layout_height="38dp" android:clickable="false" android:focusable="false" android:text="Photos" android:textSize="13sp" />
                        <Button style="@style/Haul.Segment" android:layout_height="38dp" android:layout_marginEnd="0dp" android:clickable="false" android:focusable="false" android:text="Sound" android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/welcomeNotify"
                    style="@style/Haul.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Next, Haul asks to send notifications. That's where a download shows its progress, then Share and Delete once it's saved."
                    android:textSize="14sp"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>
    </ScrollView>

    <!-- Where you are: one mark per step, the current one in clay. -->
    <LinearLayout
        android:id="@+id/welcomeSteps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:orientation="horizontal" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/welcomeBack"
            style="@style/Haul.Button.Outline"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:text="Back"
            android:visibility="gone" />

        <Button
            android:id="@+id/welcomeNext"
            style="@style/Haul.Button.Primary"
            android:layout_width="0dp"
            android:layout_weight="2"
            android:text="Next" />
    </LinearLayout>
</LinearLayout>
