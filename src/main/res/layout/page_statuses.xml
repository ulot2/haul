<?xml version="1.0" encoding="utf-8"?>
<!--
STATUSES: WhatsApp's own tab in Haul. The statuses the user has opened in WhatsApp (WhatsApp keeps them about a
day), as a grid of pictures, newest first. Tap one to save it to the Gallery; tap a saved one (✓) to watch it.
The first time, a card asks for access to WhatsApp's statuses folder through Android's folder picker.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pageStatuses"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ground"
    android:clipToPadding="false"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/stContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <TextView
            style="@style/Haul.Heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STATUSES"
            android:textSize="40sp" />

        <TextView
            style="@style/Haul.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingMultiplier="1.3"
            android:text="The statuses you've opened in WhatsApp, which it keeps for about a day. Tap one to save it to your Gallery; tap a saved one to watch it." />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button android:id="@+id/stWhatsApp" style="@style/Haul.Chip" android:text="WhatsApp" />
            <Button android:id="@+id/stBusiness" style="@style/Haul.Chip" android:text="Business" />
        </LinearLayout>

        <!-- Not allowed yet (or the access was taken back): why, and the button that opens the folder picker. -->
        <LinearLayout
            android:id="@+id/stConnect"
            style="@style/Haul.Card"
            android:layout_marginTop="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/stConnectTitle"
                style="@style/Haul.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/stConnectBody"
                style="@style/Haul.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingMultiplier="1.3" />

            <Button
                android:id="@+id/stConnectGo"
                style="@style/Haul.Button.Primary"
                android:layout_width="match_parent"
                android:layout_marginTop="14dp"
                android:text="Allow access" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/stBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/stCount"
                style="@style/Haul.Label"
                android:layout_width="0dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/stSaveAll"
                style="@style/Haul.Button.Outline"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:drawableStart="@drawable/ic_download"
                android:drawablePadding="6dp"
                android:text="Save all"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/stEmpty"
            style="@style/Haul.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:lineSpacingMultiplier="1.3"
            android:textSize="15sp"
            android:visibility="gone" />

        <!-- Rows of three, filled in code. -->
        <LinearLayout
            android:id="@+id/stGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
