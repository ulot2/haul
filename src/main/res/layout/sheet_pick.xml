<?xml version="1.0" encoding="utf-8"?>
<!-- PICK FROM THE POST: an Instagram carousel's photos and videos in a grid; tap to leave one out or put it back.
     Also the brief "Reading the link" sheet while Haul looks up a TikTok short link. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="10dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <View style="@style/Haul.Handle" />

    <TextView
        android:id="@+id/pickTitle"
        style="@style/Haul.Heading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="PICK FROM THE POST" />

    <LinearLayout
        android:id="@+id/pickReading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ProgressBar
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:indeterminateTint="@color/clay" />

        <TextView
            android:id="@+id/pickStatus"
            style="@style/Haul.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Reading the post…" />
    </LinearLayout>

    <TextView
        android:id="@+id/pickHint"
        style="@style/Haul.Label"
        android:layout_marginTop="14dp"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/pickScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:scrollbars="none"
        android:visibility="gone">

        <GridLayout
            android:id="@+id/pickGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:useDefaultMargins="false" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/pickButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/pickAll"
            style="@style/Haul.Button.Outline"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/pickGo"
            style="@style/Haul.Button.Primary"
            android:layout_width="0dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1.4" />
    </LinearLayout>
</LinearLayout>
