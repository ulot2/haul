<?xml version="1.0" encoding="utf-8"?>
<!--
Haul's screen: three tabs over one ground, the tab bar at the bottom in the ground's own color (no line), so it blends in.
- DOWNLOAD (page_download): where Haul opens. The wordmark and the link field; a link opens HAUL THIS AS.
- DOWNLOADS: the hold. Every download as a numbered ticket with its picture; search, filters; long-press to select.
- STATUSES (page_statuses): WhatsApp's statuses.
The status bar's height pads each page's top, the navigation bar the tab bar's bottom, in code. With the keyboard up the
tab bar steps aside, so the field stays in view.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ground"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/pages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include layout="@layout/page_download" />

        <!-- DOWNLOADS: the hold. -->
        <FrameLayout
            android:id="@+id/pageHold"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <ScrollView
                android:id="@+id/scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:scrollbars="none">

                <!-- Top padding grows by the status bar; bottom by the selection bar while selecting, in code. -->
                <LinearLayout
                    android:id="@+id/content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusableInTouchMode="true"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="22dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Haul.Heading"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="DOWNLOADS"
                            android:textSize="40sp" />

                        <TextView
                            android:id="@+id/wifiBadge"
                            style="@style/Haul.Label"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_badge"
                            android:paddingStart="7dp"
                            android:paddingTop="3dp"
                            android:paddingEnd="7dp"
                            android:paddingBottom="3dp"
                            android:text="Wi-Fi only"
                            android:textColor="@color/ink"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/count"
                            style="@style/Haul.Label" />
                    </LinearLayout>

                    <!-- Search the hold: captions, titles, creators, sites, links, ticket numbers. Works with the filters. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_field"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="4dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:alpha="0.6"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_search" />

                        <EditText
                            android:id="@+id/search"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:background="@null"
                            android:fontFamily="@font/archivo_regular"
                            android:hint="Search captions, creators, sites"
                            android:imeOptions="actionSearch"
                            android:importantForAutofill="no"
                            android:inputType="text"
                            android:maxLines="1"
                            android:textColor="@color/ink"
                            android:textColorHint="@color/ink_muted"
                            android:textSize="15sp" />

                        <ImageButton
                            android:id="@+id/searchClear"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@null"
                            android:contentDescription="Clear search"
                            android:scaleType="center"
                            android:src="@drawable/ic_close"
                            android:visibility="gone" />
                    </LinearLayout>

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/filters"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <Button android:id="@+id/fAll" style="@style/Haul.Chip" android:text="All" />
                            <Button android:id="@+id/fVideo" style="@style/Haul.Chip" android:text="Videos" />
                            <Button android:id="@+id/fPhotos" style="@style/Haul.Chip" android:text="Photos" />
                            <Button android:id="@+id/fAudio" style="@style/Haul.Chip" android:text="Audio" />
                            <Button android:id="@+id/fFailed" style="@style/Haul.Chip" android:text="Failed" />
                        </LinearLayout>
                    </HorizontalScrollView>

                    <!-- Notifications are off: downloads from the share sheet would finish without a word. -->
                    <LinearLayout
                        android:id="@+id/notifyCard"
                        style="@style/Haul.Card"
                        android:layout_marginTop="16dp"
                        android:visibility="gone">

                        <TextView
                            style="@style/Haul.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Notifications are off" />

                        <TextView
                            style="@style/Haul.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Haul uses them to show progress, and to share or open each video once it's in your Gallery." />

                        <Button
                            android:id="@+id/notifyOn"
                            style="@style/Haul.Button.Outline"
                            android:layout_width="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Turn on" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/hold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:divider="@drawable/divider"
                        android:orientation="vertical"
                        android:showDividers="middle|end" />

                    <TextView
                        android:id="@+id/empty"
                        style="@style/Haul.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="32dp"
                        android:textSize="15sp" />
                </LinearLayout>
            </ScrollView>

            <!-- While selecting rows: how many, and what to do with them. A floating card at the bottom of the page. -->
            <LinearLayout
                android:id="@+id/dock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_dock"
                android:elevation="12dp"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/selectCount"
                        style="@style/Haul.Heading"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="26sp" />

                    <Button
                        android:id="@+id/selectAll"
                        style="@style/Haul.Button.Outline"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="All"
                        android:textSize="14sp" />

                    <ImageButton
                        android:id="@+id/selectClose"
                        style="@style/Haul.IconButton"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:contentDescription="Stop selecting"
                        android:src="@drawable/ic_close" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/selectShare"
                        style="@style/Haul.Button.Outline"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:drawableStart="@drawable/ic_share"
                        android:drawablePadding="8dp"
                        android:text="Share" />

                    <Button
                        android:id="@+id/selectDelete"
                        style="@style/Haul.Button.Primary"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:drawableStart="@drawable/ic_trash"
                        android:text="Delete"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <include
            layout="@layout/page_statuses"
            android:visibility="gone" />
    </FrameLayout>

    <!-- The tabs: the current one's icon in clay and its name in bold ink, the others muted. -->
    <LinearLayout
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ground"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/tabDownload"
            style="@style/Haul.Tab">

            <ImageView
                android:id="@+id/tabDownloadIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_download" />

            <TextView
                android:id="@+id/tabDownloadLabel"
                style="@style/Haul.TabLabel"
                android:text="Download" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabHold"
            style="@style/Haul.Tab">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="24dp">

                <ImageView
                    android:id="@+id/tabHoldIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_tab_list" />

                <!-- Downloads going or waiting. -->
                <TextView
                    android:id="@+id/tabHoldCount"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:layout_gravity="end|top"
                    android:layout_marginTop="-4dp"
                    android:background="@drawable/bg_count"
                    android:fontFamily="@font/jetbrains_mono_semibold"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:minWidth="18dp"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:textColor="@color/on_clay"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/tabHoldLabel"
                style="@style/Haul.TabLabel"
                android:text="Downloads" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabStatuses"
            style="@style/Haul.Tab">

            <ImageView
                android:id="@+id/tabStatusesIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_status" />

            <TextView
                android:id="@+id/tabStatusesLabel"
                style="@style/Haul.TabLabel"
                android:text="Statuses" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
