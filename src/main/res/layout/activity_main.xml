<?xml version="1.0" encoding="utf-8"?>
<!--
THE HOLD (Freight). Haul is a cargo manifest: every download is a numbered ticket with its picture.
STORY: most hauls start from the share sheet. When this screen is open, the copied link waits in the dock at the
bottom, one tap from downloading; the hold above shows what came in. Tap a row for its sheet.
FIRST VIEWPORT: the wordmark, the filters, the newest hauls, and the dock.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ground">

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <!-- Top padding grows by the status bar, bottom by the dock's height, in code. -->
        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="22dp"
            android:paddingEnd="20dp"
            android:paddingBottom="180dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_mark" />

                <TextView
                    style="@style/Haul.Wordmark"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="HAUL" />

                <ImageButton
                    android:id="@+id/settings"
                    style="@style/Haul.IconButton"
                    android:contentDescription="Settings"
                    android:src="@drawable/ic_sliders" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/count"
                    style="@style/Haul.Label"
                    android:layout_width="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/wifiBadge"
                    style="@style/Haul.Label"
                    android:background="@drawable/bg_badge"
                    android:paddingStart="7dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="7dp"
                    android:paddingBottom="3dp"
                    android:text="Wi-Fi only"
                    android:textColor="@color/ink"
                    android:visibility="gone" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/filters"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button android:id="@+id/fAll" style="@style/Haul.Chip" android:text="All" />
                    <Button android:id="@+id/fVideo" style="@style/Haul.Chip" android:text="Videos" />
                    <Button android:id="@+id/fPhotos" style="@style/Haul.Chip" android:text="Photos" />
                    <Button android:id="@+id/fAudio" style="@style/Haul.Chip" android:text="Audio" />
                    <Button android:id="@+id/fFailed" style="@style/Haul.Chip" android:text="Failed" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- A newer Haul on GitHub. -->
            <LinearLayout
                android:id="@+id/updateCard"
                style="@style/Haul.Card"
                android:layout_marginTop="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/updateTitle"
                    style="@style/Haul.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    style="@style/Haul.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Download it, open it, and tap Update. Your hold stays." />

                <Button
                    android:id="@+id/update"
                    style="@style/Haul.Button.Outline"
                    android:layout_width="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Download update" />
            </LinearLayout>

            <!-- Notifications are off: downloads from the share sheet would finish without a word. -->
            <LinearLayout
                android:id="@+id/notifyCard"
                style="@style/Haul.Card"
                android:layout_marginTop="16dp"
                android:visibility="gone">

                <TextView
                    style="@style/Haul.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Notifications are off" />

                <TextView
                    style="@style/Haul.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Haul uses them to show progress, and to share or open each video once it's in your Gallery." />

                <Button
                    android:id="@+id/notifyOn"
                    style="@style/Haul.Button.Outline"
                    android:layout_width="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Turn on" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/hold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:divider="@drawable/divider"
                android:orientation="vertical"
                android:showDividers="middle|end" />

            <TextView
                android:id="@+id/empty"
                style="@style/Haul.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:textSize="15sp" />
        </LinearLayout>
    </ScrollView>

    <!-- The dock: the copied link, one tap away; otherwise "Add a link". Its bottom margin grows by the nav bar. -->
    <LinearLayout
        android:id="@+id/dock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_dock"
        android:elevation="12dp"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:id="@+id/dockClip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/dockLabel"
                style="@style/Haul.Label" />

            <TextView
                android:id="@+id/dockLink"
                style="@style/Haul.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="middle"
                android:singleLine="true"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/dockOptions"
                    style="@style/Haul.Button.Outline"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="Options" />

                <Button
                    android:id="@+id/dockDownload"
                    style="@style/Haul.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="2"
                    android:drawableStart="@drawable/ic_download"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/dockAdd"
            style="@style/Haul.Button.Primary"
            android:layout_width="match_parent"
            android:drawableStart="@drawable/ic_plus"
            android:text="Add a link"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
