<?xml version="1.0" encoding="utf-8"?>
<!--
THESIS: Haul is Ferry's sister: the same sea chart, but the course runs one way, from the internet into your hold.
STORY: Most hauls start from the share sheet and never open this screen. When it is open: paste a link (it fills
itself from the clipboard), tap Download, watch the hold. Tap a finished haul to play it; tap a failed one to retry.
FIRST VIEWPORT: the chart with the wordmark, then the link field, the quality choice and the magenta Download button.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- The chart, edge to edge. Its height and the wordmark's top margin grow by the status-bar inset in code. -->
        <FrameLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="168dp"
            android:background="@drawable/chart">

            <TextView
                android:id="@+id/wordmark"
                style="@style/Haul.Wordmark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_marginStart="20dp"
                android:layout_marginTop="16dp"
                android:text="HAUL" />

            <TextView
                style="@style/Haul.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="20dp"
                android:layout_marginBottom="14dp"
                android:text="Any link, into your Gallery" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/link"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_field"
                    android:fontFamily="@font/barlow_regular"
                    android:hint="TikTok, Instagram or X link"
                    android:imeOptions="actionGo"
                    android:importantForAutofill="no"
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/ink_muted"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/paste"
                    style="@style/Haul.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Paste" />
            </LinearLayout>

            <RadioGroup
                android:id="@+id/quality"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_segment"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/qBest"
                    style="@style/Haul.Segment"
                    android:text="Best" />

                <RadioButton
                    android:id="@+id/qSmall"
                    style="@style/Haul.Segment"
                    android:text="720p" />

                <RadioButton
                    android:id="@+id/qAudio"
                    style="@style/Haul.Segment"
                    android:text="Audio" />
            </RadioGroup>

            <Button
                android:id="@+id/download"
                style="@style/Haul.Button.Primary"
                android:layout_width="match_parent"
                android:layout_marginTop="16dp"
                android:text="Download" />

            <TextView
                android:id="@+id/tip"
                style="@style/Haul.Hint"
                android:layout_marginTop="10dp"
                android:text="Faster: in TikTok, Instagram or X tap Share, then Haul." />

            <!-- A newer Haul on GitHub. -->
            <LinearLayout
                android:id="@+id/updateCard"
                style="@style/Haul.Notice"
                android:visibility="gone">

                <TextView
                    android:id="@+id/updateTitle"
                    style="@style/Haul.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    style="@style/Haul.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Download it, open it, and tap Update. Your hold stays." />

                <Button
                    android:id="@+id/update"
                    style="@style/Haul.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Download update" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Haul.Label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="The hold"
                    android:textColor="@color/ink"
                    android:textSize="18sp" />

                <Button
                    android:id="@+id/clear"
                    style="@style/Haul.Button.Text"
                    android:layout_width="wrap_content"
                    android:text="Clear"
                    android:visibility="gone" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="6dp"
                android:background="@color/rule" />

            <LinearLayout
                android:id="@+id/hold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/divider"
                android:orientation="vertical"
                android:showDividers="middle" />

            <TextView
                android:id="@+id/empty"
                style="@style/Haul.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Nothing yet. Videos you download land in your Gallery, in the Movies/Haul album (audio in Music/Haul)." />

            <!-- yt-dlp does the fetching; sites change, so it updates itself daily. This is the manual way. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/engine"
                    style="@style/Haul.Hint"
                    android:layout_width="0dp"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/engineUpdate"
                    style="@style/Haul.Button.Text"
                    android:layout_width="wrap_content"
                    android:text="Update engine" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
