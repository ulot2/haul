<?xml version="1.0" encoding="utf-8"?>
<!--
DOWNLOAD: where Haul opens. The wordmark and one link field; its round clay button pastes, then (with a link in the
field) opens HAUL THIS AS: quality, clip, Download. A copied link fills the field and opens it by itself.
Behind: the feed (tilted cards from the sites Haul reads) and the one Haul pulls out of it, in clay, as in the logo;
it fades into the ground before the wordmark. Decoration only.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pageDownload"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/feed"
        android:layout_width="match_parent"
        android:layout_height="520dp"
        android:clipChildren="false"
        android:importantForAccessibility="noHideDescendants">

        <LinearLayout
            android:layout_width="150dp"
            android:layout_height="78dp"
            android:layout_marginStart="-36dp"
            android:layout_marginTop="58dp"
            android:alpha="0.55"
            android:background="@drawable/bg_feed"
            android:backgroundTint="@color/tone2"
            android:orientation="vertical"
            android:paddingStart="44dp"
            android:paddingTop="12dp"
            android:rotation="-9">

            <TextView style="@style/Haul.FeedTag" android:text="X" />
            <View android:layout_width="70dp" android:layout_height="6dp" android:layout_marginTop="8dp" android:background="@drawable/bg_feed_line" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="150dp"
            android:layout_height="78dp"
            android:layout_marginStart="132dp"
            android:layout_marginTop="26dp"
            android:alpha="0.6"
            android:background="@drawable/bg_feed"
            android:backgroundTint="@color/tone1"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:rotation="5">

            <TextView style="@style/Haul.FeedTag" android:text="IG" />
            <View android:layout_width="84dp" android:layout_height="6dp" android:layout_marginTop="8dp" android:background="@drawable/bg_feed_line" />
            <View android:layout_width="52dp" android:layout_height="6dp" android:layout_marginTop="8dp" android:background="@drawable/bg_feed_line" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="150dp"
            android:layout_height="78dp"
            android:layout_marginStart="300dp"
            android:layout_marginTop="78dp"
            android:alpha="0.55"
            android:background="@drawable/bg_feed"
            android:backgroundTint="@color/tone4"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:rotation="-4">

            <TextView style="@style/Haul.FeedTag" android:text="YT" />
            <View android:layout_width="60dp" android:layout_height="6dp" android:layout_marginTop="8dp" android:background="@drawable/bg_feed_line" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="150dp"
            android:layout_height="78dp"
            android:layout_marginStart="30dp"
            android:layout_marginTop="168dp"
            android:alpha="0.6"
            android:background="@drawable/bg_feed"
            android:backgroundTint="@color/tone0"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:rotation="3">

            <TextView style="@style/Haul.FeedTag" android:text="TT" />
            <View android:layout_width="90dp" android:layout_height="6dp" android:layout_marginTop="8dp" android:background="@drawable/bg_feed_line" />
            <View android:layout_width="40dp" android:layout_height="6dp" android:layout_marginTop="8dp" android:background="@drawable/bg_feed_line" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="150dp"
            android:layout_height="78dp"
            android:layout_marginStart="236dp"
            android:layout_marginTop="190dp"
            android:alpha="0.5"
            android:background="@drawable/bg_feed"
            android:backgroundTint="@color/tone3"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:rotation="-7">

            <TextView style="@style/Haul.FeedTag" android:text="FB" />
            <View android:layout_width="76dp" android:layout_height="6dp" android:layout_marginTop="8dp" android:background="@drawable/bg_feed_line" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="150dp"
            android:layout_height="78dp"
            android:layout_marginStart="-50dp"
            android:layout_marginTop="288dp"
            android:alpha="0.45"
            android:background="@drawable/bg_feed"
            android:backgroundTint="@color/tone5"
            android:orientation="vertical"
            android:paddingStart="64dp"
            android:paddingTop="12dp"
            android:rotation="-2">

            <TextView style="@style/Haul.FeedTag" android:text="RD" />
        </LinearLayout>

        <View
            android:layout_width="150dp"
            android:layout_height="78dp"
            android:layout_marginStart="320dp"
            android:layout_marginTop="300dp"
            android:alpha="0.45"
            android:background="@drawable/bg_feed"
            android:backgroundTint="@color/tone2"
            android:rotation="6" />

        <!-- The one pulled out of the feed: clay, lifted, tilted like the logo's card. -->
        <FrameLayout
            android:layout_width="132dp"
            android:layout_height="70dp"
            android:layout_marginStart="150dp"
            android:layout_marginTop="116dp"
            android:background="@drawable/bg_feed"
            android:backgroundTint="@color/clay"
            android:elevation="14dp"
            android:rotation="-6">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_play_fill" />
        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_feed_fade"
            android:elevation="16dp"
            android:outlineProvider="none" />
    </FrameLayout>

    <!-- Top padding grows by the status bar, in code. -->
    <LinearLayout
        android:id="@+id/downloadContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="20dp"
        android:focusableInTouchMode="true"
        android:orientation="vertical"
        android:outlineProvider="none"
        android:paddingStart="24dp"
        android:paddingTop="22dp"
        android:paddingEnd="24dp">

        <!-- A newer Haul on GitHub. -->
        <LinearLayout
            android:id="@+id/updateCard"
            style="@style/Haul.Card"
            android:layout_marginTop="4dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/updateTitle"
                style="@style/Haul.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                style="@style/Haul.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Download it, open it, and tap Update. Your downloads stay." />

            <Button
                android:id="@+id/update"
                style="@style/Haul.Button.Outline"
                android:layout_width="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Download update" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="56dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_mark" />

            <TextView
                style="@style/Haul.Wordmark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="HAUL"
                android:textSize="60sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/linkBox"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="8dp">

            <EditText
                android:id="@+id/linkField"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:ellipsize="end"
                android:fontFamily="@font/archivo_regular"
                android:hint="Paste a link"
                android:imeOptions="actionGo"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:maxLines="1"
                android:textColor="@color/ink"
                android:textColorHint="@color/ink_muted"
                android:textSize="17sp" />

            <!-- Clears the field in one tap. -->
            <ImageButton
                android:id="@+id/linkClear"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@null"
                android:contentDescription="Clear the link"
                android:scaleType="center"
                android:src="@drawable/ic_close"
                android:tint="@color/ink_muted"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/linkGo"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_go"
                android:contentDescription="Paste"
                android:scaleType="center"
                android:src="@drawable/ic_paste"
                android:stateListAnimator="@animator/press"
                android:tint="@color/on_clay" />
        </LinearLayout>

        <TextView
            android:id="@+id/sites"
            style="@style/Haul.Label"
            android:layout_width="match_parent"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="TikTok · Instagram · X · YouTube · +1000 more" />

        <!-- A copied link, offered (never pasted unasked): Download puts it in the field and opens HAUL THIS AS, × lets
             it go for good. Only for links that look like a post on a site Haul knows. -->
        <LinearLayout
            android:id="@+id/suggest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_dock"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="10dp"
            android:paddingEnd="6dp"
            android:paddingBottom="10dp"
            android:visibility="gone">

            <FrameLayout
                android:id="@+id/suggestBox"
                android:layout_width="34dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_thumb">

                <TextView
                    android:id="@+id/suggestTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:fontFamily="@font/jetbrains_mono_semibold"
                    android:textColor="@android:color/white"
                    android:textSize="9sp" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/suggestAsk"
                    style="@style/Haul.Label" />

                <TextView
                    android:id="@+id/suggestLink"
                    style="@style/Haul.Meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="middle"
                    android:singleLine="true"
                    android:textColor="@color/ink" />
            </LinearLayout>

            <Button
                android:id="@+id/suggestYes"
                style="@style/Haul.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Download"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/suggestNo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@null"
                android:contentDescription="No, let this link go"
                android:scaleType="center"
                android:src="@drawable/ic_close"
                android:tint="@color/ink_muted" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="96dp" />
    </LinearLayout>
</FrameLayout>
