<?xml version="1.0" encoding="utf-8"?>
<!-- CLIP A SECTION: Haul reads the video's length and picture, then two sliders pick the start and the end. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="10dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <View style="@style/Haul.Handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/clipBack"
            style="@style/Haul.IconButton"
            android:contentDescription="Back"
            android:src="@drawable/ic_back" />

        <TextView
            style="@style/Haul.Heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="CLIP A SECTION" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/clipPreviewBox"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_preview">

        <ImageView
            android:id="@+id/clipPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/clipPreviewLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:background="@drawable/bg_len"
            android:fontFamily="@font/jetbrains_mono_regular"
            android:paddingStart="5dp"
            android:paddingTop="2dp"
            android:paddingEnd="5dp"
            android:paddingBottom="2dp"
            android:textColor="@android:color/white"
            android:textSize="11sp" />

        <ProgressBar
            android:id="@+id/clipLoading"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:indeterminateTint="@android:color/white" />
    </FrameLayout>

    <TextView
        android:id="@+id/clipStatus"
        style="@style/Haul.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Reading the video's length…" />

    <LinearLayout
        android:id="@+id/clipControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/clipRange"
                style="@style/Haul.Number"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/ink"
                android:textSize="34sp" />

            <TextView
                android:id="@+id/clipLength"
                style="@style/Haul.Label" />
        </LinearLayout>

        <!-- The whole video as a bar, the chosen section in clay. Placed in code. -->
        <FrameLayout
            android:id="@+id/clipTrack"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_track">

            <View
                android:id="@+id/clipSelection"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:alpha="0.85"
                android:background="@drawable/bg_selection" />
        </FrameLayout>

        <TextView
            android:id="@+id/clipStartLabel"
            style="@style/Haul.Label"
            android:layout_marginTop="16dp"
            android:labelFor="@+id/clipStart" />

        <SeekBar
            android:id="@+id/clipStart"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:progressBackgroundTint="@color/raised"
            android:progressTint="@color/clay"
            android:thumbTint="@color/clay" />

        <TextView
            android:id="@+id/clipEndLabel"
            style="@style/Haul.Label"
            android:layout_marginTop="6dp"
            android:labelFor="@+id/clipEnd" />

        <SeekBar
            android:id="@+id/clipEnd"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:progressBackgroundTint="@color/raised"
            android:progressTint="@color/clay"
            android:thumbTint="@color/clay" />

        <TextView
            style="@style/Haul.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Haul cuts at the nearest keyframe, so the clip may start a second or two early."
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/clipWhole"
            style="@style/Haul.Button.Outline"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="Whole video" />

        <Button
            android:id="@+id/clipUse"
            style="@style/Haul.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:enabled="false"
            android:text="Use section" />
    </LinearLayout>
</LinearLayout>
