<?xml version="1.0" encoding="utf-8"?>
<!-- CLIP THE SOUND: a section of a saved download's sound, to the tenth of a second, heard before it's saved.
     Saved as an M4A of its own in Music/Haul; the download it came from stays as it is. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <View style="@style/Haul.Handle" />

        <TextView
            style="@style/Haul.Heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="CLIP THE SOUND" />

        <TextView
            android:id="@+id/cutTitle"
            style="@style/Haul.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2" />

        <ImageView
            android:id="@+id/cutLoading"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/avd_loader" />

        <TextView
            android:id="@+id/cutStatus"
            style="@style/Haul.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Opening the sound…" />

        <LinearLayout
            android:id="@+id/cutControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/cutRange"
                    style="@style/Haul.Mono"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/ink"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/cutLength"
                    style="@style/Haul.Label" />
            </LinearLayout>

            <!-- Start: the slider for the rough place, − and + for a tenth of a second either way. -->
            <TextView
                android:id="@+id/cutStartLabel"
                style="@style/Haul.Label"
                android:layout_marginTop="16dp"
                android:labelFor="@+id/cutStart" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/cutStartLess"
                    style="@style/Haul.Button.Outline"
                    android:layout_width="44dp"
                    android:layout_height="40dp"
                    android:contentDescription="Start a tenth of a second earlier"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:text="−" />

                <SeekBar
                    android:id="@+id/cutStart"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:progressBackgroundTint="@color/raised"
                    android:progressTint="@color/clay"
                    android:thumbTint="@color/clay" />

                <Button
                    android:id="@+id/cutStartMore"
                    style="@style/Haul.Button.Outline"
                    android:layout_width="44dp"
                    android:layout_height="40dp"
                    android:contentDescription="Start a tenth of a second later"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:text="+" />
            </LinearLayout>

            <TextView
                android:id="@+id/cutEndLabel"
                style="@style/Haul.Label"
                android:layout_marginTop="10dp"
                android:labelFor="@+id/cutEnd" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/cutEndLess"
                    style="@style/Haul.Button.Outline"
                    android:layout_width="44dp"
                    android:layout_height="40dp"
                    android:contentDescription="End a tenth of a second earlier"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:text="−" />

                <SeekBar
                    android:id="@+id/cutEnd"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:progressBackgroundTint="@color/raised"
                    android:progressTint="@color/clay"
                    android:thumbTint="@color/clay" />

                <Button
                    android:id="@+id/cutEndMore"
                    style="@style/Haul.Button.Outline"
                    android:layout_width="44dp"
                    android:layout_height="40dp"
                    android:contentDescription="End a tenth of a second later"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:text="+" />
            </LinearLayout>

            <Button
                android:id="@+id/cutPlay"
                style="@style/Haul.Button.Outline"
                android:layout_width="match_parent"
                android:layout_marginTop="16dp"
                android:drawableStart="@drawable/ic_play"
                android:drawablePadding="8dp"
                android:text="Play the section" />

            <Button
                android:id="@+id/cutSave"
                style="@style/Haul.Button.Primary"
                android:layout_width="match_parent"
                android:layout_marginTop="10dp"
                android:text="Save the sound" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
