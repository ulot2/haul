<?xml version="1.0" encoding="utf-8"?>
<!-- One haul, opened: its picture and facts, the main action (Play, Try again, or Cancel), and four more. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <View style="@style/Haul.Handle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/sheetThumbBox"
                android:layout_width="84dp"
                android:layout_height="150dp"
                android:background="@drawable/bg_thumb">

                <ImageView
                    android:id="@+id/sheetThumb"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop" />

                <ImageView
                    android:id="@+id/sheetThumbIcon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:tint="@android:color/white"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/sheetTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:fontFamily="@font/jetbrains_mono_semibold"
                    android:shadowColor="#99000000"
                    android:shadowRadius="3"
                    android:textColor="@android:color/white"
                    android:textSize="11sp" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/sheetNo"
                    style="@style/Haul.Label" />

                <TextView
                    android:id="@+id/sheetTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/archivo_semibold"
                    android:lineSpacingMultiplier="1.15"
                    android:maxLines="5"
                    android:ellipsize="end"
                    android:textColor="@color/ink"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/sheetSite"
                    style="@style/Haul.Meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/sheetError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_error_box"
            android:fontFamily="@font/archivo_regular"
            android:lineSpacingMultiplier="1.3"
            android:padding="14dp"
            android:textColor="@color/ink"
            android:textSize="15sp"
            android:visibility="gone" />

        <!-- Two columns of LABEL / value pairs, filled in code. -->
        <LinearLayout
            android:id="@+id/sheetFacts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical" />

        <Button
            android:id="@+id/sheetPrimary"
            style="@style/Haul.Button.Primary"
            android:layout_width="match_parent"
            android:layout_marginTop="18dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/actShare"
                style="@style/Haul.Button.Outline"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_share"
                android:drawablePadding="4dp"
                android:paddingStart="0dp"
                android:paddingTop="10dp"
                android:paddingEnd="0dp"
                android:text="Share"
                android:textSize="12sp" />

            <Button
                android:id="@+id/actCopy"
                style="@style/Haul.Button.Outline"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_link"
                android:drawablePadding="4dp"
                android:paddingStart="0dp"
                android:paddingTop="10dp"
                android:paddingEnd="0dp"
                android:text="Copy link"
                android:textSize="12sp" />

            <Button
                android:id="@+id/actAgain"
                style="@style/Haul.Button.Outline"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_again"
                android:drawablePadding="4dp"
                android:paddingStart="0dp"
                android:paddingTop="10dp"
                android:paddingEnd="0dp"
                android:text="Again"
                android:textSize="12sp" />

            <Button
                android:id="@+id/actRemove"
                style="@style/Haul.Button.Outline"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_trash"
                android:drawablePadding="4dp"
                android:paddingStart="0dp"
                android:paddingTop="10dp"
                android:paddingEnd="0dp"
                android:text="Remove"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
