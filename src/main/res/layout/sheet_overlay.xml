<?xml version="1.0" encoding="utf-8"?>
<!-- KEEP SCROLLING: asked once, the first time a shared post has to be read. Haul may float a badge over the app while
     it reads (Android's "Display over other apps"); without it, a notification does the same job. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/oScrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#99000000"
    android:clickable="true"
    android:contentDescription="Not now"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/oSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_sheet"
        android:clickable="true"
        android:focusable="false"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <View style="@style/Haul.Handle" />

        <TextView
            style="@style/Haul.Heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="KEEP SCROLLING" />

        <TextView
            style="@style/Haul.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Haul reads this post while you carry on. A small badge floats over the app you're in: drag it anywhere, and it pulses when there's something to pick. Android asks you to let Haul display over other apps."
            android:textSize="15sp" />

        <Button
            android:id="@+id/oAllow"
            style="@style/Haul.Button.Primary"
            android:layout_width="match_parent"
            android:layout_marginTop="18dp"
            android:text="Allow the badge" />

        <Button
            android:id="@+id/oLater"
            style="@style/Haul.Button.Outline"
            android:layout_width="match_parent"
            android:layout_marginTop="10dp"
            android:text="Not now: a notification will do" />
    </LinearLayout>
</FrameLayout>
