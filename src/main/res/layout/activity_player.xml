<?xml version="1.0" encoding="utf-8"?>
<!--
THE PLAYER: a haul's files, one at a time, on near-black whatever the theme (pictures read best on dark).
Video and audio play with Haul's own controls; photos and GIFs show fitted (GIFs move). Swipe for the next file of a
post. Tap to show or hide the bars. The top bar's buttons share the file or open it in the Gallery.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/playerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0B0A">

    <VideoView
        android:id="@+id/playerVideo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />

    <ImageView
        android:id="@+id/playerImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <!-- Audio: no picture, so a card with the note and the title. -->
    <LinearLayout
        android:id="@+id/playerAudio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/playerAudioArt"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:background="@drawable/bg_preview">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_music"
                android:tint="@android:color/white" />
        </FrameLayout>

        <TextView
            android:id="@+id/playerAudioTitle"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/archivo_semibold"
            android:gravity="center"
            android:maxLines="3"
            android:ellipsize="end"
            android:textColor="#F4F0E8"
            android:textSize="18sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/playerError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="32dp"
        android:fontFamily="@font/archivo_regular"
        android:gravity="center"
        android:textColor="#F4F0E8"
        android:textSize="16sp"
        android:visibility="gone" />

    <!-- Top bar: back, title and "2 / 5", share, open in Gallery. Padded by the status bar in code. -->
    <LinearLayout
        android:id="@+id/playerTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#99000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <ImageButton
            android:id="@+id/playerBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_row"
            android:contentDescription="Back"
            android:src="@drawable/ic_back"
            android:tint="#F4F0E8" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/playerTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/archivo_semibold"
                android:singleLine="true"
                android:textColor="#F4F0E8"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/playerCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/jetbrains_mono_regular"
                android:letterSpacing="0.09"
                android:textColor="#A8A298"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/playerShare"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_row"
            android:contentDescription="Share"
            android:src="@drawable/ic_share"
            android:tint="#F4F0E8" />

        <ImageButton
            android:id="@+id/playerGallery"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_row"
            android:contentDescription="Open in the Gallery"
            android:src="@drawable/ic_photos"
            android:tint="#F4F0E8" />
    </LinearLayout>

    <!-- Bottom bar: play or pause, where it is, and how long. Video and audio only. Padded by the nav bar in code. -->
    <LinearLayout
        android:id="@+id/playerBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#99000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <ImageButton
            android:id="@+id/playerPlay"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_check_on"
            android:contentDescription="Play or pause"
            android:scaleType="center"
            android:tint="@color/on_clay" />

        <SeekBar
            android:id="@+id/playerSeek"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:contentDescription="Position"
            android:progressBackgroundTint="#55F4F0E8"
            android:progressTint="@color/clay"
            android:thumbTint="@color/clay" />

        <TextView
            android:id="@+id/playerTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="@font/jetbrains_mono_regular"
            android:fontFeatureSettings="tnum"
            android:textColor="#F4F0E8"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
