<?xml version="1.0" encoding="utf-8"?>
<!-- SETTINGS (the fourth tab): how downloads behave, the shortcuts into Haul, notifications, the engine, and about. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pageSettings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ground"
    android:clipToPadding="false"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/settingsContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="22dp"
        android:paddingEnd="20dp"
        android:paddingBottom="40dp">

        <TextView
            style="@style/Haul.Heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SETTINGS"
            android:textSize="40sp" />

        <!-- Downloads -->
        <TextView style="@style/Haul.Label" android:layout_marginTop="26dp" android:text="Downloads" />

        <LinearLayout style="@style/Haul.Card" android:layout_marginTop="10dp">

            <TextView
                style="@style/Haul.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Default quality" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button android:id="@+id/sBest" style="@style/Haul.Segment" android:text="Best" />
                <Button android:id="@+id/sSmall" style="@style/Haul.Segment" android:text="720p" />
                <Button android:id="@+id/sAudio" style="@style/Haul.Segment" android:layout_marginEnd="0dp" android:text="Audio" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="16dp" android:background="@color/line" />

            <!-- Where new downloads go in the Gallery: all together, a folder per site, or a folder per creator. -->
            <TextView style="@style/Haul.Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Folders" />
            <TextView android:id="@+id/foldersHelp" style="@style/Haul.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button android:id="@+id/fOne" style="@style/Haul.Segment" android:text="One" />
                <Button android:id="@+id/fSite" style="@style/Haul.Segment" android:text="By site" />
                <Button android:id="@+id/fCreator" style="@style/Haul.Segment" android:layout_marginEnd="0dp" android:text="By creator" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="16dp" android:background="@color/line" />

            <LinearLayout
                android:id="@+id/rowAsk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/Haul.Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ask when sharing" />
                    <TextView style="@style/Haul.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textSize="13sp" android:text="HAUL THIS AS opens over TikTok: the quality, and Clip a section if you want only part of it. Off: it downloads at once." />
                </LinearLayout>

                <Switch android:id="@+id/swAsk" style="@style/Haul.Switch" android:layout_marginStart="14dp" android:contentDescription="Ask when sharing" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="14dp" android:background="@color/line" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/Haul.Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Haul audio in the share sheet" />
                    <TextView style="@style/Haul.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textSize="13sp" android:text="A second share target that saves just the sound." />
                </LinearLayout>

                <Switch android:id="@+id/swAudio" style="@style/Haul.Switch" android:layout_marginStart="14dp" android:contentDescription="Haul audio in the share sheet" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="14dp" android:background="@color/line" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/Haul.Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Wi-Fi only" />
                    <TextView android:id="@+id/wifiHelp" style="@style/Haul.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textSize="13sp" />
                </LinearLayout>

                <Switch android:id="@+id/swWifi" style="@style/Haul.Switch" android:layout_marginStart="14dp" android:contentDescription="Wi-Fi only" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="14dp" android:background="@color/line" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView style="@style/Haul.Title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Saved to" />
                <TextView style="@style/Haul.Mono" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="end" android:text="Movies/Haul\nPictures/Haul\nMusic/Haul" />
            </LinearLayout>
        </LinearLayout>

        <!-- Shortcuts -->
        <TextView style="@style/Haul.Label" android:layout_marginTop="22dp" android:text="Shortcuts" />

        <LinearLayout style="@style/Haul.Card" android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/Haul.Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Quick Settings tile" />
                <TextView android:id="@+id/tileHelp" style="@style/Haul.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textSize="13sp" android:text="Copy a link anywhere, pull down the shade, tap Haul." />
            </LinearLayout>

            <Button android:id="@+id/addTile" style="@style/Haul.Button.Outline" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginStart="14dp" android:text="Add tile" />
        </LinearLayout>

        <!-- The badge that floats over other apps while Haul reads a shared post (Display over other apps). -->
        <LinearLayout style="@style/Haul.Card" android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/badgeState" style="@style/Haul.Title" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView style="@style/Haul.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textSize="13sp" android:text="While Haul reads a post you shared, a badge floats over the app: carry on, drag it anywhere. It pulses when there's something to pick." />
            </LinearLayout>

            <Button android:id="@+id/badgeSettings" style="@style/Haul.Button.Outline" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginStart="14dp" android:text="Open" />
        </LinearLayout>

        <!-- Your list: a backup file, to keep it or take it to a new phone. -->
        <TextView style="@style/Haul.Label" android:layout_marginTop="22dp" android:text="Your list" />

        <LinearLayout style="@style/Haul.Card" android:layout_marginTop="10dp">
            <TextView style="@style/Haul.Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Back up your downloads list" />
            <TextView style="@style/Haul.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textSize="13sp" android:text="Titles, captions, links and dates, in one file you keep (in Drive, say). Restore it on a new phone: each download is one tap from coming back." />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
                <Button android:id="@+id/backupSave" style="@style/Haul.Button.Outline" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="Back up" />
                <Button android:id="@+id/backupRestore" style="@style/Haul.Button.Outline" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginStart="10dp" android:layout_weight="1" android:text="Restore" />
            </LinearLayout>
        </LinearLayout>

        <!-- Notifications -->
        <TextView style="@style/Haul.Label" android:layout_marginTop="22dp" android:text="Notifications" />

        <LinearLayout style="@style/Haul.Card" android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/notifState" style="@style/Haul.Title" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView style="@style/Haul.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textSize="13sp" android:text="Progress, and Share or Delete on each saved video." />
            </LinearLayout>

            <Button android:id="@+id/notifSettings" style="@style/Haul.Button.Outline" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginStart="14dp" android:text="Open" />
        </LinearLayout>

        <!-- Engine -->
        <TextView style="@style/Haul.Label" android:layout_marginTop="22dp" android:text="Engine" />

        <LinearLayout style="@style/Haul.Card" android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/engineVersion" style="@style/Haul.Title" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/engineHelp" style="@style/Haul.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textSize="13sp" android:text="Updates itself daily, after your downloads finish." />
            </LinearLayout>

            <Button android:id="@+id/engineUpdate" style="@style/Haul.Button.Outline" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginStart="14dp" android:text="Update" />
        </LinearLayout>

        <!-- About -->
        <TextView style="@style/Haul.Label" android:layout_marginTop="22dp" android:text="About" />

        <LinearLayout style="@style/Haul.Card" android:layout_marginTop="10dp">
            <TextView android:id="@+id/aboutVersion" style="@style/Haul.Title" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView style="@style/Haul.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textSize="13sp" android:text="No account, no ads, no server. yt-dlp runs on this phone. Download only what you have the right to keep." />

            <!-- Haul itself (the engine has its own Update above). Says what it found; with a newer Haul, downloads it. -->
            <Button
                android:id="@+id/aboutCheck"
                style="@style/Haul.Button.Outline"
                android:layout_width="match_parent"
                android:layout_marginTop="14dp"
                android:text="Check for updates" />

            <TextView
                android:id="@+id/aboutCheckResult"
                style="@style/Haul.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="13sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/aboutWelcome"
                style="@style/Haul.Button.Outline"
                android:layout_width="match_parent"
                android:layout_marginTop="10dp"
                android:text="How to use Haul" />

            <Button
                android:id="@+id/aboutNews"
                style="@style/Haul.Button.Outline"
                android:layout_width="match_parent"
                android:layout_marginTop="10dp"
                android:text="What\'s new in Haul" />

            <Button
                android:id="@+id/aboutReport"
                style="@style/Haul.Button.Outline"
                android:layout_width="match_parent"
                android:layout_marginTop="10dp"
                android:text="Save an Instagram report" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
