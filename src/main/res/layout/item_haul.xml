<?xml version="1.0" encoding="utf-8"?>
<!-- One haul, as a ticket: its picture, its number, what it is, where from, and how it went. Tap opens its sheet. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_row"
    android:orientation="horizontal"
    android:paddingTop="14dp"
    android:paddingBottom="14dp">

    <!-- The picture: the saved video's own frame from the Gallery; a tone and the site tag until then. -->
    <FrameLayout
        android:id="@+id/thumbBox"
        android:layout_width="54dp"
        android:layout_height="96dp"
        android:background="@drawable/bg_thumb">

        <ImageView
            android:id="@+id/thumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/thumbIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:tint="@android:color/white"
            android:visibility="gone" />

        <TextView
            android:id="@+id/thumbTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="6dp"
            android:fontFamily="@font/jetbrains_mono_semibold"
            android:shadowColor="#99000000"
            android:shadowRadius="3"
            android:textColor="@android:color/white"
            android:textSize="10sp" />

        <!-- While selecting rows: a clay check, or an empty ring. -->
        <ImageView
            android:id="@+id/thumbCheck"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="top|end"
            android:layout_margin="4dp"
            android:importantForAccessibility="no"
            android:padding="3dp"
            android:tint="@color/on_clay"
            android:visibility="gone" />

        <TextView
            android:id="@+id/thumbLen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="5dp"
            android:background="@drawable/bg_len"
            android:fontFamily="@font/jetbrains_mono_regular"
            android:paddingStart="4dp"
            android:paddingTop="1dp"
            android:paddingEnd="4dp"
            android:paddingBottom="1dp"
            android:textColor="@android:color/white"
            android:textSize="10sp"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/itemNo"
            style="@style/Haul.Label" />

        <TextView
            android:id="@+id/itemTitle"
            style="@style/Haul.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.1"
            android:maxLines="2" />

        <TextView
            android:id="@+id/itemMeta"
            style="@style/Haul.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:maxLines="2" />

        <ProgressBar
            android:id="@+id/itemProgress"
            style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="8dp"
            android:indeterminateTint="@color/clay"
            android:max="1000"
            android:progressDrawable="@drawable/progress_bar"
            android:visibility="gone" />
    </LinearLayout>

    <!-- The right edge: the percent while downloading, WAITING, an outlined FAILED, or the size once saved. -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="10dp"
        android:minWidth="56dp">

        <TextView
            android:id="@+id/itemPct"
            style="@style/Haul.Number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:textColor="@color/clay_text"
            android:visibility="gone" />

        <TextView
            android:id="@+id/itemState"
            style="@style/Haul.Label"
            android:layout_gravity="end|center_vertical"
            android:gravity="end"
            android:maxWidth="96dp"
            android:textAllCaps="false" />

        <TextView
            android:id="@+id/itemFailed"
            style="@style/Haul.Label"
            android:layout_gravity="end|center_vertical"
            android:background="@drawable/bg_badge_failed"
            android:fontFamily="@font/jetbrains_mono_semibold"
            android:paddingStart="7dp"
            android:paddingTop="4dp"
            android:paddingEnd="7dp"
            android:paddingBottom="4dp"
            android:text="Failed"
            android:textColor="@color/ink"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
