<?xml version="1.0" encoding="utf-8"?>
<!-- The Download page's link field: a pill on the surface, outlined in clay once it holds a link (activated) or is typed in. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <solid android:color="@color/surface" />
            <stroke android:width="1.5dp" android:color="@color/clay" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <solid android:color="@color/surface" />
            <stroke android:width="1dp" android:color="@color/line" />
        </shape>
    </item>
</selector>
