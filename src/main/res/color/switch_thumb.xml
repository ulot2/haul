<?xml version="1.0" encoding="utf-8"?>
<!-- Switch knob: dark brown on the clay track when on, muted ink when off. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/line" android:state_enabled="false" />
    <item android:color="@color/on_clay" android:state_checked="true" />
    <item android:color="@color/ink_muted" />
</selector>
