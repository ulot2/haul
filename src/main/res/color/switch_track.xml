<?xml version="1.0" encoding="utf-8"?>
<!-- Switch track: clay when on, the raised grey when off. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:alpha="0.4" android:color="@color/line" android:state_enabled="false" />
    <item android:color="@color/clay" android:state_checked="true" />
    <item android:color="@color/raised" />
</selector>
