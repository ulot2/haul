<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Haul" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:colorAccent">@color/clay</item>
        <item name="android:colorControlActivated">@color/clay</item>
        <item name="android:colorControlHighlight">@color/ripple</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink_muted</item>
        <item name="android:textColorHint">@color/ink_muted</item>
        <item name="android:fontFamily">@font/archivo_regular</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- The bottom sheets: a dialog pinned to the bottom, full width, dimming what is behind. -->
    <style name="Theme.Haul.Sheet" parent="@android:style/Theme.DeviceDefault.Light.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.InputMethod</item>
        <item name="android:colorAccent">@color/clay</item>
        <item name="android:colorControlActivated">@color/clay</item>
        <item name="android:colorControlHighlight">@color/ripple</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorHint">@color/ink_muted</item>
        <item name="android:fontFamily">@font/archivo_regular</item>
    </style>

    <!-- The player: dark in both themes (pictures read best on dark), so light status bar icons. -->
    <style name="Theme.Haul.Player" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorAccent">@color/clay</item>
        <item name="android:colorControlActivated">@color/clay</item>
        <item name="android:fontFamily">@font/archivo_regular</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Over another app (share sheet, tile): see-through, no animation, and the quality sheet draws its own dim. -->
    <style name="Theme.Haul.Over" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:colorAccent">@color/clay</item>
        <item name="android:colorControlHighlight">@color/ripple</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:fontFamily">@font/archivo_regular</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
