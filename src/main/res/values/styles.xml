<?xml version="1.0" encoding="utf-8"?>
<!-- Freight type roles and parts. See DESIGN.md. -->
<resources>
    <!-- Empty base: "Haul.X" names make Android look for a parent called "Haul". -->
    <style name="Haul" />

    <!-- Condensed capitals: the wordmark, sheet and screen headings, big numbers. -->
    <style name="Haul.Wordmark">
        <item name="android:textSize">40sp</item>
        <item name="android:fontFamily">@font/archivo_condensed_black</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Haul.Heading" parent="Haul.Wordmark">
        <item name="android:textSize">32sp</item>
    </style>

    <style name="Haul.Number">
        <item name="android:textSize">30sp</item>
        <item name="android:fontFamily">@font/archivo_condensed_extrabold</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Mono capitals: the manifest facts. -->
    <style name="Haul.Label">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">@font/jetbrains_mono_regular</item>
        <item name="android:letterSpacing">0.09</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/ink_muted</item>
    </style>

    <style name="Haul.Mono">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/jetbrains_mono_regular</item>
        <item name="android:textColor">@color/ink_muted</item>
    </style>

    <style name="Haul.Title">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/archivo_semibold</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="Haul.Body">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/archivo_regular</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
        <item name="android:textColor">@color/ink_muted</item>
    </style>

    <style name="Haul.Meta">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/archivo_regular</item>
        <item name="android:textColor">@color/ink_muted</item>
    </style>

    <!-- A card on the ground: settings groups and notices. -->
    <style name="Haul.Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="Haul.Button">
        <item name="android:layout_height">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/archivo_semibold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Haul.Button.Primary">
        <item name="android:layout_height">54dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">@font/archivo_extrabold</item>
        <item name="android:background">@drawable/bg_primary</item>
        <item name="android:textColor">@color/on_clay</item>
        <item name="android:drawableTint">@color/on_clay</item>
        <item name="android:drawablePadding">8dp</item>
    </style>

    <style name="Haul.Button.Outline">
        <item name="android:background">@drawable/bg_outline</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <!-- A square icon button (back, settings), 44dp. -->
    <style name="Haul.IconButton">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/bg_outline</item>
        <item name="android:scaleType">center</item>
        <item name="android:tint">@color/ink</item>
    </style>

    <!-- A filter chip: ink fill when chosen (setActivated), outlined otherwise. -->
    <style name="Haul.Chip" parent="Haul.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:textColor">@color/chip_text</item>
    </style>

    <!-- One choice of three (quality): same look as a chip, square-ish. -->
    <style name="Haul.Segment" parent="Haul.Chip">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/archivo_extrabold</item>
        <item name="android:background">@drawable/bg_segment</item>
    </style>

    <style name="Haul.Switch">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:thumbTint">@color/switch_thumb</item>
        <item name="android:trackTint">@color/switch_track</item>
    </style>

    <!-- The small grey bar at the top of a sheet. -->
    <style name="Haul.Handle">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">4dp</item>
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="android:background">@drawable/bg_handle</item>
    </style>
</resources>
